{
  "name": "ctf-agent-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build:sandbox": "docker build --pull -t ctf-agent-solver:latest packages/sandbox/docker",
    "build:webui": "pnpm --filter @ctf-agent/webui build:client",
    "check": "biome check .",
    "test": "vitest run",
    "test:runner": "vitest run packages/core/test/runner/contest-runner.test.ts",
    "test:watch": "vitest",
    "webui": "pnpm build:webui && node --experimental-transform-types packages/webui/src/main.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "^24.10.1",
    "esbuild": "0.28.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
