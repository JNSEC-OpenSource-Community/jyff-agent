{
	"name": "ctf-agent-workspace",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.17.0",
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"build:sandbox": "docker build --pull -t ctf-agent-solver:latest packages/sandbox/docker",
		"check": "biome check .",
		"test": "vitest run",
		"test:runner": "vitest run packages/core/test/runner/contest-runner.test.ts",
		"test:watch": "vitest",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint .",
		"lint:fix": "biome check --write .",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.6",
		"@earendil-works/pi-agent-core": "^0.82.1",
		"@earendil-works/pi-ai": "^0.82.1",
		"@types/node": "^24.10.1",
		"typescript": "^5.9.3",
		"vitest": "^4.1.10"
	}
}
