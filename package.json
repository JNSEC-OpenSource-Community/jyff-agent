{
  "name": "ctf-agent-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build:sandbox": "docker build --pull -t ctf-agent-solver:latest packages/sandbox/docker",
    "test": "vitest run",
    "test:runner": "vitest run packages/project/test/runner/contest-runner.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "example": "pnpm --filter @ctf-agent/example-ctf solve",
    "webui": "pnpm --filter @ctf-agent/example-ctf webui"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.82.1",
    "@earendil-works/pi-ai": "^0.82.1",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
