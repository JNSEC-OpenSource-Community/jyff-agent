# 复制此文件为 .env 并填入你的配置
# cp .env.example .env

# API 密钥（必填）
CTF_MODEL_API_KEY = "sk-your-api-key-here"

# 模型 ID（必填）
# DeepSeek: deepseek-chat
# OpenRouter: openai/gpt-4o
CTF_MODEL_ID = "deepseek-chat"

# 以下为可选配置：
# Provider（默认 "openrouter"，DeepSeek 等自定义 API 建议同时设置 CTF_MODEL_BASE_URL）
# CTF_MODEL_PROVIDER = "deepseek"

# API Base URL（DeepSeek 为 https://api.deepseek.com）
# CTF_MODEL_BASE_URL = "https://api.deepseek.com"

# Context Window（默认 64000）
# CTF_MODEL_CONTEXT_WINDOW = 64000

# Max Tokens（默认 4096）
# CTF_MODEL_MAX_TOKENS = 4096

# WebUI 混合调度控制面
# CTF_SCHEDULER_AUTO_START = false
# CTF_SCHEDULER_MAX_CONCURRENT = 2
# CTF_SCHEDULER_MAX_ATTEMPTS = 2
# CTF_SCHEDULER_TIMEOUT_MS = 1800000
# CTF_SCHEDULER_RETRY_DELAY_MS = 2000

# full 会保存完整工具命令、结果和平台确认 Flag；safe 会脱敏。
# CTF_TELEMETRY_LEVEL = full
# CTF_TELEMETRY_MAX_TEXT_LENGTH = 8000

# 平台远程模式(可选,覆盖 ctf-config.json 的 platform.config)
# CTF_PLATFORM_BASE_URL = "http://127.0.0.1:25001"
# CTF_PLATFORM_TOKEN = ""
