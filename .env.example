# 复制此文件为 .env 并填入你的配置
# cp .env.example .env

# API 密钥（必填）
CTF_MODEL_API_KEY = "sk-your-api-key-here"

# 模型 ID（必填）
# DeepSeek: deepseek-chat
# OpenRouter: openai/gpt-4o
CTF_MODEL_ID = "deepseek-chat"

# 以下为可选配置：
# Provider（默认 "openrouter"，DeepSeek 等自定义 API 建议同时设置 CTF_MODEL_BASE_URL）
# CTF_MODEL_PROVIDER = "deepseek"

# API Base URL（DeepSeek 为 https://api.deepseek.com）
# CTF_MODEL_BASE_URL = "https://api.deepseek.com"

# Context Window（默认 64000）
# CTF_MODEL_CONTEXT_WINDOW = 64000

# Max Tokens（默认 4096）
# CTF_MODEL_MAX_TOKENS = 4096
